#!/bin/bash
# Downtime: dims every display while the screensaver runs and restores it after.
#
# Usage: dim down <percent> | dim up | dim check | dim probe
#        dim fade-start <percent> <step-seconds> | dim fade-stop [seconds]
#
# down   saves each display's brightness and lowers it to <percent> (displays
#        already at or below that, or still saved, are left alone).
# up     restores the saved values, retrying while displays wake up.
# check  restores only when no screensaver is running. The service calls it
#        as a safety net whenever saved values are left behind.
# probe  exits 0 when at least one display's brightness can be controlled,
#        1 when none can, 3 when it cannot tell (busy, or every display off).
#        On 0 it prints the highest normal brightness (a dimmed display counts
#        with its saved value), so the widget can tell how long a fade takes.
# fade-start  (called by the service once the idle delay passed) lowers every lit
#        display by one percent every <step-seconds> down to <percent>, in a
#        transient unit that stays alive until fade-stop. Nothing happens
#        while Omarchy's Stay Awake is on.
# fade-stop    (called on activity) ends that unit and restores the saved
#        brightness, waiting up to <seconds> (180) for displays to wake up.
#        While a screensaver opens or runs, the service restores instead.
#
# Brightness goes through omarchy-brightness-display, the same path as the
# brightness keys: backlight on laptops, DDC/CI on external monitors.
set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/downtime"
SAVED="$STATE_DIR/dim-saved"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/downtime-dim.lock"
RESTORE_SECONDS=180
FADE_UNIT=downtime-fade.service
STAY_AWAKE="$HOME/.local/state/omarchy/indicators/stay-awake"
# A display in deep sleep can drop off the bus entirely while it wakes up
# (Hyprland shows a FALLBACK output meanwhile). It is waited for this long
# before it counts as unplugged.
MISSING_SECONDS=30

usage() {
  echo "usage: dim down <percent> | dim up | dim check | dim probe | dim fade-start <percent> <step-seconds> | dim fade-stop [seconds]" >&2
  exit 2
}

monitors() { hyprctl monitors -j 2>/dev/null | jq -r '.[].name'; }
# Displays that are connected and lit. DDC rarely answers while a display is off.
lit_monitors() { hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.dpmsStatus) | .name'; }
saver_running() { pgrep -f '[o]rg.omarchy.screensaver' >/dev/null; }
# The launcher runs before any screensaver window exists.
saver_starting() { pgrep -f '[o]rg.omarchy.screensaver|[o]marchy-launch-screensaver' >/dev/null; }
fade_running() { systemctl --user is-active --quiet "$FADE_UNIT"; }

brightness() {
  local value
  value=$(omarchy-brightness-display --monitor "$1" 2>/dev/null) || return 1
  [[ $value =~ ^[0-9]{1,3}$ ]] || return 1
  echo "$value"
}

# omarchy-brightness-display-ddc remembers a display without DDC for a minute
# and fails at once meanwhile. A display that just woke up often misses its
# first DDC request, so forget that before every try.
forget_ddc_failure() {
  local file="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display-ddc/${1//[^[:alnum:]_.-]/_}.bus" state
  [[ -r $file ]] && read -r state _ <"$file" && [[ $state == unavailable ]] && rm -f "$file"
  return 0
}

# Some monitors acknowledge a write they ignore (often right after waking up),
# so read it back. DDC rounding can be one step off.
set_brightness() {
  local monitor=$1 target=$2 now
  for _ in 1 2 3; do
    forget_ddc_failure "$monitor"
    omarchy-brightness-display --no-osd --monitor "$monitor" "$target%" >/dev/null 2>&1
    now=$(brightness "$monitor") && (( now >= target - 1 && now <= target + 1 )) && return 0
    sleep 0.5
  done
  return 1
}

down() {
  local target=$1 monitor current saved
  # Displays still saved are dimmed already (or unplugged and waiting for
  # their restore). Saving them again would store the dimmed value, so they
  # keep their saved one and are only dimmed further if still brighter.
  saved=" $( [[ -f $SAVED ]] && awk '{ print $1 }' "$SAVED" | tr '\n' ' ')"
  mkdir -p "$STATE_DIR"
  for monitor in $(monitors); do
    current=$(brightness "$monitor") || continue
    (( current > target )) || continue
    # Saved before writing, so even a half-applied change gets restored. One
    # that is saved already (partly faded when idle) keeps its first value.
    [[ $saved == *" $monitor "* ]] || echo "$monitor $current" >>"$SAVED"
    set_brightness "$monitor" "$target"
  done
}

# Restores every saved display until all are done or the time is up. A
# display that is connected but still off (waking from screen off) is waited
# for, and so is one that is missing for a short while. One that stays
# unplugged stays saved; the service's safety net restores it once it is back.
up() {
  local deadline=$((SECONDS + $1)) missing_until=$((SECONDS + MISSING_SECONDS))
  local monitor value connected lit left waiting
  [[ -f $SAVED ]] || return 0
  while :; do
    connected=" $(monitors | tr '\n' ' ')"
    lit=" $(lit_monitors | tr '\n' ' ')"
    left=""
    waiting=0
    while read -r monitor value; do
      [[ -n $monitor && $value =~ ^[0-9]{1,3}$ ]] || continue
      if [[ $lit == *" $monitor "* ]]; then
        set_brightness "$monitor" "$value" && continue
        waiting=1
      elif [[ $connected == *" $monitor "* ]] || (( SECONDS < missing_until )); then
        waiting=1
      fi
      left+="$monitor $value"$'\n'
    done <"$SAVED"

    if [[ -z $left ]]; then
      rm -f "$SAVED"
      return 0
    fi
    printf '%s' "$left" >"$SAVED"
    (( waiting && SECONDS < deadline )) || return 1
    sleep 2
  done
}

# Runs inside the fade unit. The start brightness is read fresh and saved first,
# so a restore always returns to what it was. Each step takes the lock, so a
# restore never races a write. Afterwards it just waits to be stopped: the
# service's safety net leaves saved values alone while this unit is active.
fade() {
  local target=$1 step=$2 monitor current next saved lit
  local -A level=()
  mkdir -p "$STATE_DIR"
  flock 9
  saved=" $( [[ -f $SAVED ]] && awk '{ print $1 }' "$SAVED" | tr '\n' ' ')"
  for monitor in $(lit_monitors); do
    [[ $saved == *" $monitor "* ]] && continue
    current=$(brightness "$monitor") || continue
    (( current > target )) || continue
    echo "$monitor $current" >>"$SAVED"
    level[$monitor]=$current
  done
  flock -u 9
  while (( ${#level[@]} )); do
    sleep "$step"
    # The screensaver's own dimming takes over; never lift it back up.
    saver_running && break
    flock 9
    # A display that turned off keeps its level until activity restores it.
    lit=" $(lit_monitors | tr '\n' ' ')"
    for monitor in "${!level[@]}"; do
      [[ $lit == *" $monitor "* ]] || continue
      next=$(( level[$monitor] - 1 ))
      omarchy-brightness-display --no-osd --monitor "$monitor" "$next%" >/dev/null 2>&1
      level[$monitor]=$next
      (( next > target )) || unset "level[$monitor]"
    done
    flock -u 9
  done
  exec sleep infinity
}

# Only lit displays count: one that is off cannot answer and is no proof.
probe() {
  local monitor value current any=0 best=-1
  for monitor in $(lit_monitors); do
    any=1
    value=$( [[ -f $SAVED ]] && awk -v m="$monitor" '$1 == m && $2 ~ /^[0-9]+$/ { print $2; exit }' "$SAVED")
    # A display that just woke up often misses its first DDC request. A
    # single miss would grey out dimming (and turn off the idle fade) until
    # the next probe.
    for _ in 1 2 3; do
      forget_ddc_failure "$monitor"
      if current=$(brightness "$monitor"); then
        value=${value:-$current}
        (( value > best )) && best=$value
        break
      fi
      sleep 0.5
    done
  done
  (( best >= 0 )) && { echo "$best"; return 0; }
  (( any )) && return 1
  return 3
}

mkdir -p "${LOCK%/*}"
exec 9>"$LOCK"

case "${1:-}" in
down)
  (( $# == 2 )) && [[ $2 =~ ^[0-9]{1,2}$ ]] && (( 10#$2 >= 1 && 10#$2 <= 99 )) || usage
  # Never let two runs interleave, or a restore races a new dim.
  flock 9
  down $(( 10#$2 ))
  ;;
up)
  (( $# == 1 )) || usage
  flock 9
  up "$RESTORE_SECONDS"
  ;;
check)
  (( $# == 1 )) || usage
  [[ -f $SAVED ]] || exit 0
  # Runs repeatedly; skip while a dim or restore is already at work.
  flock -n 9 || exit 0
  # A running fade holds saved values on purpose until activity stops it.
  saver_running || fade_running || up 10
  ;;
probe)
  (( $# == 1 )) || usage
  flock -n 9 || exit 3
  probe
  ;;
fade-start)
  (( $# == 3 )) && [[ $2 =~ ^[0-9]{1,2}$ ]] && (( 10#$2 >= 1 && 10#$2 <= 99 )) \
    && [[ $3 =~ ^[0-9]{1,2}$ ]] && (( 10#$3 >= 1 && 10#$3 <= 60 )) || usage
  systemctl --user stop "$FADE_UNIT" 2>/dev/null
  # Omarchy's Stay Awake leaves the screen as it is.
  [[ -e $STAY_AWAKE ]] && exit 0
  exec systemd-run --user --quiet --collect --unit="${FADE_UNIT%.service}" \
    "$(readlink -f "$0")" fade-run $(( 10#$2 )) $(( 10#$3 ))
  ;;
fade-run)
  (( $# == 3 )) && [[ $2 =~ ^[0-9]{1,2}$ && $3 =~ ^[0-9]{1,2}$ ]] || usage
  fade "$2" "$3"
  ;;
fade-stop)
  (( $# <= 2 )) && [[ ${2:-$RESTORE_SECONDS} =~ ^[0-9]{1,3}$ ]] || usage
  systemctl --user stop "$FADE_UNIT" 2>/dev/null
  # Opening the screensaver resets the idle clock, so it ends the fade like
  # activity does. Restoring now would light up the screensaver; its own
  # dimming takes over, and the service restores once it closes.
  saver_starting && exit 0
  flock 9
  up $(( 10#${2:-$RESTORE_SECONDS} ))
  ;;
*) usage ;;
esac
