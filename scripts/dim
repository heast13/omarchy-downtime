#!/bin/bash
# Downtime: dims every display while the screensaver runs and restores it after.
#
# Usage: dim down <percent> | dim up | dim check | dim probe
#
# down   saves each display's brightness and lowers it to <percent> (displays
#        already at or below that, or still saved, are left alone).
# up     restores the saved values, retrying while displays wake up.
# check  restores only when no screensaver is running. The service calls it
#        as a safety net whenever saved values are left behind.
# probe  exits 0 when at least one display's brightness can be controlled,
#        1 when none can, 3 when it cannot tell (busy, or every display off).
#
# Brightness goes through omarchy-brightness-display, the same path as the
# brightness keys: backlight on laptops, DDC/CI on external monitors.
set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/downtime"
SAVED="$STATE_DIR/dim-saved"
LOCK="${XDG_RUNTIME_DIR:-/tmp}/downtime-dim.lock"
RESTORE_SECONDS=180
# A display in deep sleep can drop off the bus entirely while it wakes up
# (Hyprland shows a FALLBACK output meanwhile). It is waited for this long
# before it counts as unplugged.
MISSING_SECONDS=30

usage() {
  echo "usage: dim down <percent> | dim up | dim check | dim probe" >&2
  exit 2
}

monitors() { hyprctl monitors -j 2>/dev/null | jq -r '.[].name'; }
# Displays that are connected and lit. DDC rarely answers while a display is off.
lit_monitors() { hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.dpmsStatus) | .name'; }
saver_running() { pgrep -f '[o]rg.omarchy.screensaver' >/dev/null; }

brightness() {
  local value
  value=$(omarchy-brightness-display --monitor "$1" 2>/dev/null) || return 1
  [[ $value =~ ^[0-9]{1,3}$ ]] || return 1
  echo "$value"
}

# omarchy-brightness-display-ddc remembers a display without DDC for a minute
# and fails at once meanwhile. A display that just woke up often misses its
# first DDC request, so forget that before every try.
forget_ddc_failure() {
  local file="${XDG_RUNTIME_DIR:-/tmp}/omarchy-brightness-display-ddc/${1//[^[:alnum:]_.-]/_}.bus" state
  [[ -r $file ]] && read -r state _ <"$file" && [[ $state == unavailable ]] && rm -f "$file"
  return 0
}

# Some monitors acknowledge a write they ignore (often right after waking up),
# so read it back. DDC rounding can be one step off.
set_brightness() {
  local monitor=$1 target=$2 now
  for _ in 1 2 3; do
    forget_ddc_failure "$monitor"
    omarchy-brightness-display --no-osd --monitor "$monitor" "$target%" >/dev/null 2>&1
    now=$(brightness "$monitor") && (( now >= target - 1 && now <= target + 1 )) && return 0
    sleep 0.5
  done
  return 1
}

down() {
  local target=$1 monitor current saved
  # Displays still saved are dimmed already (or unplugged and waiting for
  # their restore). Saving them again would store the dimmed value, but the
  # others are dimmed as usual.
  saved=" $( [[ -f $SAVED ]] && awk '{ print $1 }' "$SAVED" | tr '\n' ' ')"
  mkdir -p "$STATE_DIR"
  for monitor in $(monitors); do
    [[ $saved == *" $monitor "* ]] && continue
    current=$(brightness "$monitor") || continue
    (( current > target )) || continue
    # Saved before writing, so even a half-applied change gets restored.
    echo "$monitor $current" >>"$SAVED"
    set_brightness "$monitor" "$target"
  done
}

# Restores every saved display until all are done or the time is up. A
# display that is connected but still off (waking from screen off) is waited
# for, and so is one that is missing for a short while. One that stays
# unplugged stays saved; the service's safety net restores it once it is back.
up() {
  local deadline=$((SECONDS + $1)) missing_until=$((SECONDS + MISSING_SECONDS))
  local monitor value connected lit left waiting
  [[ -f $SAVED ]] || return 0
  while :; do
    connected=" $(monitors | tr '\n' ' ')"
    lit=" $(lit_monitors | tr '\n' ' ')"
    left=""
    waiting=0
    while read -r monitor value; do
      [[ -n $monitor && $value =~ ^[0-9]{1,3}$ ]] || continue
      if [[ $lit == *" $monitor "* ]]; then
        set_brightness "$monitor" "$value" && continue
        waiting=1
      elif [[ $connected == *" $monitor "* ]] || (( SECONDS < missing_until )); then
        waiting=1
      fi
      left+="$monitor $value"$'\n'
    done <"$SAVED"

    if [[ -z $left ]]; then
      rm -f "$SAVED"
      return 0
    fi
    printf '%s' "$left" >"$SAVED"
    (( waiting && SECONDS < deadline )) || return 1
    sleep 2
  done
}

# Only lit displays count: one that is off cannot answer and is no proof.
probe() {
  local monitor any=0
  for monitor in $(lit_monitors); do
    any=1
    brightness "$monitor" >/dev/null && return 0
  done
  (( any )) && return 1
  return 3
}

mkdir -p "${LOCK%/*}"
exec 9>"$LOCK"

case "${1:-}" in
down)
  (( $# == 2 )) && [[ $2 =~ ^[0-9]{1,2}$ ]] && (( 10#$2 >= 1 && 10#$2 <= 99 )) || usage
  # Never let two runs interleave, or a restore races a new dim.
  flock 9
  down $(( 10#$2 ))
  ;;
up)
  (( $# == 1 )) || usage
  flock 9
  up "$RESTORE_SECONDS"
  ;;
check)
  (( $# == 1 )) || usage
  [[ -f $SAVED ]] || exit 0
  # Runs repeatedly; skip while a dim or restore is already at work.
  flock -n 9 || exit 0
  saver_running || up 10
  ;;
probe)
  (( $# == 1 )) || usage
  flock -n 9 || exit 3
  probe
  ;;
*) usage ;;
esac
