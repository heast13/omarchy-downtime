#!/bin/bash
# Downtime: applies the screensaver delay (shell.json) and the screen-off and
# sleep delays (its own hypridle instance).
#
# Usage: apply <on|off|keep> <screensaver-minutes|keep> <screen-off-minutes> <sleep-minutes>
#
# "keep keep" leaves Omarchy's screensaver settings exactly as they are.
set -u

SHELL_JSON="$HOME/.config/omarchy/shell.json"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/downtime"
HYPRIDLE_CONF="$STATE_DIR/hypridle.conf"
UNIT=downtime-hypridle.service
MAX_MIN=1440

usage() {
  echo "usage: apply <on|off|keep> <screensaver-minutes|keep> <screen-off-minutes> <sleep-minutes>" >&2
  exit 2
}

# Refuse anything unexpected rather than guess. A guessed screensaver value can
# lock the session on the spot (see below).
(( $# == 4 )) || usage
SAVER_STATE=$1
case $SAVER_STATE in
  on | off) minutes=("$2" "$3" "$4") ;;
  keep) [[ $2 == keep ]] || usage; minutes=("$3" "$4") ;;
  *) usage ;;
esac
for value in "${minutes[@]}"; do
  [[ $value =~ ^[0-9]+$ ]] && (( 10#$value <= MAX_MIN )) || usage
done
if [[ $SAVER_STATE != keep ]]; then
  SAVER=$(( 10#$2 * 60 ))
  (( SAVER >= 60 )) || SAVER=60
fi
OFF_MIN=$(( 10#$3 ))
SUSPEND_MIN=$(( 10#$4 ))

# Never let two runs interleave, or they overwrite each other's work.
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/downtime.lock"
flock 9

# ---------- screensaver (Omarchy's own idle service) ----------

# Untouched until the user sets it in the widget.
if [[ $SAVER_STATE != keep ]]; then
  # "Off" uses Omarchy's own screensaver toggle (the same one as in its menu) and
  # keeps idle.screensaver a real delay. Writing a huge "never" value instead
  # breaks Omarchy's idle timer: when it is as large as idle.lock, the shell locks
  # the session the moment its idle monitor restarts.
  if [[ $SAVER_STATE == off ]]; then
    omarchy-toggle screensaver-off on
  else
    omarchy-toggle screensaver-off off
  fi

  file_saver() { jq -r '.idle.screensaver // empty' "$SHELL_JSON" 2>/dev/null; }
  shell_status() { omarchy-shell idle status 2>/dev/null | jq -r ".$1 // empty" 2>/dev/null; }

  # Write atomically: a finished copy in the same folder, then rename, so the
  # shell never reads half a file.
  write_saver() {
    local tmp
    tmp=$(mktemp "$SHELL_JSON.XXXXXX") || return 1
    if jq --argjson s "$SAVER" '.idle = ((.idle // {}) + {screensaver: $s})' "$SHELL_JSON" >"$tmp" \
      && jq -e . "$tmp" >/dev/null 2>&1; then
      chmod --reference="$SHELL_JSON" "$tmp"
      mv -f "$tmp" "$SHELL_JSON"
    else
      rm -f "$tmp"
      return 1
    fi
  }

  SHELL_SAVER_BEFORE=$(shell_status screensaver)

  if [[ -f $SHELL_JSON ]]; then
    # The shell also writes shell.json from memory (for example when widget
    # settings are saved). If it catches a stale copy, our value is lost again,
    # so keep checking until file and shell agree.
    for _ in {1..10}; do
      [[ $(file_saver) != "$SAVER" ]] && write_saver
      sleep 0.5
      [[ $(file_saver) == "$SAVER" && $(shell_status screensaver) == "$SAVER" ]] && break
    done
  fi

  # The shell's IdleMonitor never fires again after its timeout changes at
  # runtime, so recreate it (off/on) - unless idle is deliberately off (Stay
  # Awake). The off state is persisted, so every exit path turns it back on.
  if [[ $SHELL_SAVER_BEFORE != "$SAVER" && $(shell_status enabled) == true ]]; then
    trap 'omarchy-shell -q idle enable >/dev/null 2>&1' EXIT
    trap 'exit 1' INT TERM HUP
    omarchy-shell -q idle disable >/dev/null 2>&1
    sleep 0.5
    for _ in {1..10}; do
      omarchy-shell -q idle enable >/dev/null 2>&1
      [[ $(shell_status enabled) == true ]] && break
      sleep 0.5
    done
    trap - EXIT INT TERM HUP
  fi
fi

# ---------- screen off and sleep (hypridle) ----------

# Hyprland uses a Lua config, so dispatchers take the Lua form.
DPMS_OFF="hyprctl dispatch 'hl.dsp.dpms({action = \"off\"})'"
DPMS_ON="hyprctl dispatch 'hl.dsp.dpms({action = \"on\"})'"

mkdir -p "$STATE_DIR"
tmp=$(mktemp "$HYPRIDLE_CONF.XXXXXX") || exit 1
{
  echo "# Generated by the Downtime plugin. Edit the timings in its bar widget."
  echo "general {"
  # Playing media and other inhibitors keep the machine awake.
  echo "    ignore_dbus_inhibit = false"
  # An open screensaver would otherwise survive sleep and be the first thing
  # you see on wake. omarchy-system-lock closes it the same way.
  echo "    before_sleep_cmd = pkill -x ttfx; pkill -f '[o]rg.omarchy.screensaver'"
  echo "    after_sleep_cmd = $DPMS_ON"
  echo "}"
  if (( OFF_MIN > 0 )); then
    echo
    echo "listener {"
    echo "    timeout = $((OFF_MIN * 60))"
    echo "    on-timeout = $DPMS_OFF"
    echo "    on-resume = $DPMS_ON"
    echo "}"
  fi
  if (( SUSPEND_MIN > 0 )); then
    echo
    echo "listener {"
    echo "    timeout = $((SUSPEND_MIN * 60))"
    echo "    on-timeout = systemctl suspend"
    echo "}"
  fi
} >"$tmp"
mv -f "$tmp" "$HYPRIDLE_CONF"

systemctl --user stop "$UNIT" 2>/dev/null
if (( OFF_MIN > 0 || SUSPEND_MIN > 0 )); then
  if ! command -v hypridle >/dev/null; then
    omarchy-notification-send -u critical -g 󰒲 "Downtime" \
      "hypridle is not installed. Install it with: omarchy pkg add hypridle" >/dev/null 2>&1
    exit 1
  fi

  systemd-run --user --quiet --collect --unit="$UNIT" \
    -p PartOf=graphical-session.target -p Restart=on-failure \
    hypridle -c "$HYPRIDLE_CONF"

  # A second hypridle (for example from autostart) would run its own timers
  # next to ours.
  sleep 0.5
  ours=$(systemctl --user show -p MainPID --value "$UNIT" 2>/dev/null)
  others=$(pgrep -x hypridle | grep -vx "${ours:-0}")
  if [[ -n $others ]]; then
    omarchy-notification-send -g 󰒲 "Downtime" \
      "Another hypridle is running (PID ${others//$'\n'/, }). Its timers run next to Downtime's." >/dev/null 2>&1
  fi
fi
exit 0
