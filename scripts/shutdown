#!/bin/bash
# Downtime: a one-shot shutdown timer.
#
# Usage: shutdown start <minutes> [en|de]   power off in <minutes>, replacing a running timer
#        shutdown cancel [en|de]            cancel the running timer
#        shutdown check                     forget a timer that is no longer running
#        shutdown fire <deadline> [en|de]   (run by the timer) power off, unless it is late
#        shutdown warn <deadline> [en|de]   (run by the warning timer) one minute's notice
#
# The timer runs as transient user units, so it survives shell restarts. Its
# deadline (epoch seconds) lives in a state file the widget watches.
# The timers follow the wall clock. A monotonic one pauses while the machine
# sleeps, so a manual sleep would push the shutdown back while the widget
# already shows it as done. One that comes due during sleep runs on wake, and
# is then dropped instead of powering off right away.
set -u

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/downtime"
DEADLINE_FILE="$STATE_DIR/shutdown-at"
UNIT=downtime-shutdown
WARN_UNIT=downtime-shutdown-warn
MAX_MIN=1440
LATE_SECONDS=120

usage() {
  echo "usage: shutdown start <minutes> [en|de] | cancel [en|de] | check | fire <deadline> [en|de] | warn <deadline> [en|de]" >&2
  exit 2
}

stop_units() {
  systemctl --user stop "$UNIT.timer" "$WARN_UNIT.timer" 2>/dev/null
  systemctl --user reset-failed "$UNIT.service" "$WARN_UNIT.service" 2>/dev/null
}

# Messages follow the widget's language.
msg() {
  local key=$1 lang=$2 arg=${3:-}
  case $lang:$key in
    de:at) echo "Fährt um $arg herunter." ;;
    de:warn) echo "Fährt in 1 Minute herunter." ;;
    de:cancel) echo "Ausschalt-Timer abgebrochen." ;;
    de:missed) echo "Ausschalt-Timer übersprungen: Der Rechner hat um $arg geschlafen." ;;
    *:at) echo "Shutting down at $arg." ;;
    *:warn) echo "Shutting down in 1 minute." ;;
    *:cancel) echo "Shutdown timer cancelled." ;;
    *:missed) echo "Shutdown timer skipped: the computer was asleep at $arg." ;;
  esac
}

lang_arg() {
  [[ -z ${1:-} || $1 == en || $1 == de ]] || usage
  echo "${1:-en}"
}

# A calendar time for systemd, in UTC so a clock change cannot shift it.
at_utc() { date -u -d "@$1" '+%Y-%m-%d %H:%M:%S UTC'; }

notify() {
  omarchy-notification-send -g 󰐥 "Downtime" "$1" >/dev/null 2>&1 || true
}

# Never let two runs interleave, or the deadline file and the running timer
# can disagree.
serialize() {
  exec 9>"${XDG_RUNTIME_DIR:-/tmp}/downtime-shutdown.lock"
  flock 9
}

case ${1:-} in
  start)
    (( $# == 2 || $# == 3 )) || usage
    # At most four digits: longer numbers would wrap around in bash arithmetic.
    [[ $2 =~ ^[0-9]{1,4}$ ]] && (( 10#$2 >= 1 && 10#$2 <= MAX_MIN )) || usage
    minutes=$(( 10#$2 ))
    lang=$(lang_arg "${3:-}") || exit 2
    serialize

    stop_units
    deadline=$(( $(date +%s) + minutes * 60 ))
    self=$(readlink -f "$0")
    systemd-run --user --quiet --collect --unit="$UNIT" \
      --on-calendar="$(at_utc "$deadline")" --timer-property=AccuracySec=1s \
      "$self" fire "$deadline" "$lang" || { rm -f "$DEADLINE_FILE"; exit 1; }
    if (( minutes >= 2 )); then
      systemd-run --user --quiet --collect --unit="$WARN_UNIT" \
        --on-calendar="$(at_utc $(( deadline - 60 )))" --timer-property=AccuracySec=1s \
        "$self" warn "$deadline" "$lang"
    fi

    mkdir -p "$STATE_DIR"
    echo "$deadline" >"$DEADLINE_FILE.tmp" && mv -f "$DEADLINE_FILE.tmp" "$DEADLINE_FILE"
    notify "$(msg at "$lang" "$(date -d "@$deadline" +%H:%M)")"
    ;;
  cancel)
    (( $# == 1 || $# == 2 )) || usage
    lang=$(lang_arg "${2:-}") || exit 2
    serialize
    stop_units
    if [[ -f $DEADLINE_FILE ]]; then
      rm -f "$DEADLINE_FILE"
      notify "$(msg cancel "$lang")"
    fi
    ;;
  check)
    (( $# == 1 )) || usage
    serialize
    # After a reboot or a manual stop the file outlives its timer.
    if [[ -f $DEADLINE_FILE ]] && ! systemctl --user is-active --quiet "$UNIT.timer"; then
      rm -f "$DEADLINE_FILE"
    fi
    ;;
  fire|warn)
    (( $# == 2 || $# == 3 )) && [[ $2 =~ ^[0-9]{1,12}$ ]] || usage
    deadline=$(( 10#$2 ))
    lang=$(lang_arg "${3:-}") || exit 2
    late=$(( $(date +%s) - deadline ))
    if [[ $1 == warn ]]; then
      # Late after a sleep: the real notice (or the skip message) follows.
      (( late < 0 )) && omarchy-notification-send -u critical -g 󰐥 "Downtime" "$(msg warn "$lang")" >/dev/null 2>&1
      exit 0
    fi
    serialize
    if (( late > LATE_SECONDS )); then
      stop_units
      rm -f "$DEADLINE_FILE"
      notify "$(msg missed "$lang" "$(date -d "@$deadline" +%H:%M)")"
      exit 0
    fi
    systemctl poweroff
    ;;
  *)
    usage
    ;;
esac
exit 0
