{
  "schemaVersion": 1,
  "id": "heast13.downtime",
  "name": "Downtime",
  "version": "1.5.0",
  "author": "heast13",
  "description": "Screensaver, screen-off, sleep, shutdown timer and wallpaper rotation in one bar widget.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Downtime",
    "description": "Screensaver, screen off, sleep, shutdown timer and wallpaper rotation",
    "category": "System",
    "aliases": ["downtime", "away", "snooze", "shutdown", "timer", "poweroff", "sleep", "suspend", "idle", "screensaver", "screen off", "dpms", "wallpaper", "dim", "brightness"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "wallpaperEnabled": false,
      "wallpaperMinutes": 10,
      "screensaverDimEnabled": false,
      "screensaverDimPercent": 40,
      "idleDimEnabled": false,
      "idleDimStartMinutes": 3,
      "idleDimStepSeconds": 5,
      "idleDimPercent": 50,
      "screenOffEnabled": true,
      "screenOffMinutes": 10,
      "suspendEnabled": false,
      "suspendMinutes": 30,
      "shutdownMinutes": 60,
      "language": "auto"
    },
    "schema": [
      { "key": "wallpaperEnabled", "type": "boolean", "label": "Wallpaper rotation", "defaultValue": false },
      { "key": "wallpaperMinutes", "type": "number", "label": "Rotate every (minutes)", "min": 1, "max": 1440, "step": 1, "defaultValue": 10 },
      { "key": "screensaverEnabled", "type": "boolean", "label": "Screensaver", "defaultValue": true },
      { "key": "screensaverMinutes", "type": "number", "label": "Screensaver after (minutes)", "min": 1, "max": 1440, "step": 1, "defaultValue": 5 },
      { "key": "screensaverDimEnabled", "type": "boolean", "label": "Dim during screensaver", "defaultValue": false },
      { "key": "screensaverDimPercent", "type": "number", "label": "Dim to (%)", "min": 1, "max": 99, "step": 1, "defaultValue": 40 },
      { "key": "idleDimEnabled", "type": "boolean", "label": "Dim when idle", "defaultValue": false },
      { "key": "idleDimStartMinutes", "type": "number", "label": "Start after (minutes idle)", "min": 1, "max": 60, "step": 1, "defaultValue": 3 },
      { "key": "idleDimStepSeconds", "type": "number", "label": "One step every (seconds)", "min": 1, "max": 60, "step": 1, "defaultValue": 5 },
      { "key": "idleDimPercent", "type": "number", "label": "Fade to (%)", "min": 1, "max": 99, "step": 1, "defaultValue": 50 },
      { "key": "screenOffEnabled", "type": "boolean", "label": "Screen off", "defaultValue": true },
      { "key": "screenOffMinutes", "type": "number", "label": "Screen off after (minutes)", "min": 1, "max": 1440, "step": 1, "defaultValue": 10 },
      { "key": "suspendEnabled", "type": "boolean", "label": "Sleep", "defaultValue": false },
      { "key": "suspendMinutes", "type": "number", "label": "Sleep after (minutes)", "min": 1, "max": 1440, "step": 1, "defaultValue": 30 },
      { "key": "shutdownMinutes", "type": "number", "label": "Shutdown timer (minutes)", "min": 1, "max": 1440, "step": 1, "defaultValue": 60 }
    ]
  }
}
